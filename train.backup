from __future__ import annotations

import argparse
import math
import os
import random
from pathlib import Path

import numpy as np
import torch
from torch.utils.data import DataLoader
from torch.utils.tensorboard import SummaryWriter
from tqdm import tqdm

from dataset import RandomTokenBatchStream
from model import MiniLLM
from tokenizer import load_tokenizer
from utils.checkpoint import save_checkpoint, load_checkpoint
from utils.config import load_config
from utils.chat_format import format_chat
from utils.sampling import sample_next_token


def set_seed(seed: int):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


def get_precision_dtype(precision: str):
    if precision == "bf16":
        return torch.bfloat16
    if precision == "fp16":
        return torch.float16
    return torch.float32


@torch.no_grad()
def evaluate_loss(
    model, loader, device, amp_dtype, max_batches=20, mtp_weight_1=1.0, mtp_weight_2=0.5
):
    model.eval()
    losses = []
    losses_next = []
    for i, batch in enumerate(loader):
        if i >= max_batches:
            break
        batch = batch.to(device, non_blocking=True)
        input_ids = batch[:, :-1]
        labels = batch[:, 1:]
        with torch.autocast(
            device_type=device.type,
            dtype=amp_dtype,
            enabled=amp_dtype in (torch.float16, torch.bfloat16),
        ):
            out = model(
                input_ids=input_ids,
                labels=labels,
                mtp_weight_1=mtp_weight_1,
                mtp_weight_2=mtp_weight_2,
            )
        losses.append(out.loss.item())
        if out.loss_next is not None:
            losses_next.append(out.loss_next.item())
    model.train()
    val_loss = float(np.mean(losses)) if losses else float("nan")
    val_loss_next = float(np.mean(losses_next)) if losses_next else val_loss
    return val_loss, val_loss_next


@torch.no_grad()
def generate_sample(
    model,
    tokenizer,
    prompt: str,
    device,
    amp_dtype,
    max_new_tokens=128,
    temperature=0.8,
    top_k=40,
    top_p=0.95,
    system_prompt="You are a helpful assistant.",
    use_chat=False,
):
    if use_chat:
        input_text = format_chat(
            [{"role": "user", "content": prompt}], system_prompt=system_prompt
        )
    else:
        input_text = prompt
    ids = tokenizer.encode(input_text).ids
    input_ids = torch.tensor([ids], dtype=torch.long, device=device)

    model.eval()
    for _ in range(max_new_tokens):
        ctx = input_ids[:, -model.max_seq_len :]
        with torch.autocast(
            device_type=device.type,
            dtype=amp_dtype,
            enabled=amp_dtype in (torch.float16, torch.bfloat16),
        ):
            out = model(input_ids=ctx)
        logits = out.logits[:, -1, :]
        next_id = sample_next_token(
            logits, temperature=temperature, top_k=top_k, top_p=top_p
        )
        input_ids = torch.cat([input_ids, next_id], dim=1)
        if next_id.item() == 2:
            break

    text = tokenizer.decode(input_ids[0].tolist(), skip_special_tokens=False)
    model.train()
    return text


def main():

    print("CUDA available:", torch.cuda.is_available())
    print("Current device:", torch.cuda.current_device())
    print("Device name:", torch.cuda.get_device_name(torch.cuda.current_device()))
    print("Memory allocated:", torch.cuda.memory_allocated() / 1024**2, "MB")
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", required=True)
    parser.add_argument("--resume", default=None)
    args = parser.parse_args()

    cfg = load_config(args.config)
    set_seed(cfg["training"]["seed"])

    output_dir = Path(cfg["paths"]["output_dir"])
    ckpt_dir = Path(cfg["paths"]["checkpoint_dir"])
    tb_dir = Path(cfg["paths"]["tb_dir"])
    output_dir.mkdir(parents=True, exist_ok=True)
    ckpt_dir.mkdir(parents=True, exist_ok=True)
    tb_dir.mkdir(parents=True, exist_ok=True)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    amp_dtype = get_precision_dtype(cfg["training"]["precision"])

    tokenizer = load_tokenizer(cfg["data"]["tokenizer_path"])

    model = MiniLLM(
        vocab_size=cfg["model"]["vocab_size"],
        max_seq_len=cfg["model"]["max_seq_len"],
        d_model=cfg["model"]["d_model"],
        n_layers=cfg["model"]["n_layers"],
        n_heads=cfg["model"]["n_heads"],
        n_kv_heads=cfg["model"]["n_kv_heads"],
        d_ff=cfg["model"]["d_ff"],
        dropout=cfg["model"]["dropout"],
        rotary_base=cfg["model"]["rotary_base"],
        rotary_scaling_factor=cfg["model"]["rotary_scaling_factor"],
        tie_embeddings=cfg["model"]["tie_embeddings"],
        pad_token_id=cfg["model"]["pad_token_id"],
        gradient_checkpointing=cfg["training"]["gradient_checkpointing"],  # <-- add this
    ).to(device)
    x_temp = torch.randint(
        0, cfg["model"]["vocab_size"], (1, cfg["model"]["max_seq_len"]), device=device
    )
    with torch.no_grad():
        y = model(x_temp)
    print(
        "Forward pass done, memory allocated:",
        torch.cuda.memory_allocated() / 1024**2,
        "MB",
    )
    if cfg["training"]["use_compile"] and hasattr(torch, "compile"):
        model = torch.compile(model)

    optimizer = torch.optim.AdamW(
        model.parameters(),
        lr=cfg["training"]["lr"],
        betas=tuple(cfg["training"]["betas"]),
        weight_decay=cfg["training"]["weight_decay"],
    )

    def lr_lambda(step):
        warmup = cfg["training"]["warmup_steps"]
        max_steps = cfg["training"]["max_steps"]
        if step < warmup:
            return float(step + 1) / max(1, warmup)
        progress = (step - warmup) / max(1, max_steps - warmup)
        cosine = 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))
        min_lr = cfg["training"]["min_lr"] / cfg["training"]["lr"]
        return min_lr + (1 - min_lr) * cosine

    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda=lr_lambda)
    scaler = torch.cuda.amp.GradScaler(enabled=(amp_dtype == torch.float16))

    train_stream = RandomTokenBatchStream(
        cache_path=cfg["data"]["train_cache"],
        seq_len=cfg["model"]["max_seq_len"],
        batch_size=cfg["training"]["micro_batch_size"],
        pad_token_id=cfg["model"]["pad_token_id"],
    )
    train_loader = iter(DataLoader(train_stream, batch_size=None, num_workers=0))

    val_loader = None
    if Path(cfg["data"]["val_cache"]).exists():
        val_stream = RandomTokenBatchStream(
            cache_path=cfg["data"]["val_cache"],
            seq_len=cfg["model"]["max_seq_len"],
            batch_size=cfg["training"]["micro_batch_size"],
            pad_token_id=cfg["model"]["pad_token_id"],
        )
        val_loader = iter(DataLoader(val_stream, batch_size=None, num_workers=0))

    start_step = 0
    if args.resume:
        ckpt = load_checkpoint(
            args.resume, model, optimizer, scheduler, map_location=device
        )
        start_step = int(ckpt.get("step", 0))

    writer = SummaryWriter(str(tb_dir))

    prompts = cfg["validation_prompts"]
    eval_interval = cfg["training"]["eval_every_steps"]
    save_every = cfg["training"]["save_every"]
    log_every = cfg["training"]["log_every"]
    max_steps = cfg["training"]["max_steps"]
    grad_accum = cfg["training"]["grad_accum_steps"]
    mtp_w1 = cfg["training"]["mtp_weight_1"]
    mtp_w2 = cfg["training"]["mtp_weight_2"]
    max_grad_norm = cfg["training"]["max_grad_norm"]

    use_chat_gen = cfg["training"].get("generation_use_chat", False)

    model.train()
    optimizer.zero_grad(set_to_none=True)

    pbar = tqdm(
        range(start_step, max_steps), initial=start_step, total=max_steps, desc="train"
    )
    for step in pbar:
        loss_accum = 0.0
        loss_next_accum = 0.0
        loss_next2_accum = 0.0
        for micro in range(grad_accum):
            batch = next(train_loader).to(device, non_blocking=True)
            input_ids = batch[:, :-1]
            labels = batch[:, 1:]
            with torch.autocast(
                device_type=device.type,
                dtype=amp_dtype,
                enabled=amp_dtype in (torch.float16, torch.bfloat16),
            ):
                out = model(
                    input_ids=input_ids,
                    labels=labels,
                    mtp_weight_1=mtp_w1,
                    mtp_weight_2=mtp_w2,
                )
                loss = out.loss / grad_accum
            if scaler.is_enabled():
                scaler.scale(loss).backward()
            else:
                loss.backward()
            loss_accum += loss.item()
            if out.loss_next is not None:
                loss_next_accum += out.loss_next.item() / grad_accum
            if out.loss_next2 is not None:
                loss_next2_accum += out.loss_next2.item() / grad_accum

        if scaler.is_enabled():
            scaler.unscale_(optimizer)
        grad_norm = torch.nn.utils.clip_grad_norm_(model.parameters(), max_grad_norm)

        if scaler.is_enabled():
            scaler.step(optimizer)
            scaler.update()
        else:
            optimizer.step()
        scheduler.step()
        optimizer.zero_grad(set_to_none=True)

        lr = scheduler.get_last_lr()[0]
        writer.add_scalar("train/loss", loss_accum, step)
        writer.add_scalar("train/loss_next", loss_next_accum, step)
        if loss_next2_accum > 0:
            writer.add_scalar("train/loss_mtp_aux", loss_next2_accum, step)
        if math.isfinite(loss_next_accum) and loss_next_accum > 0:
            writer.add_scalar(
                "train/perplexity", math.exp(min(20.0, loss_next_accum)), step
            )
        writer.add_scalar("train/lr", lr, step)
        writer.add_scalar("train/grad_norm", float(grad_norm), step)

        if step % log_every == 0:
            pbar.set_postfix(loss=f"{loss_accum:.4f}", lr=f"{lr:.2e}")

        if val_loader is not None and step > 0 and step % eval_interval == 0:
            val_loss, val_loss_next = evaluate_loss(
                model,
                val_loader,
                device,
                amp_dtype,
                max_batches=10,
                mtp_weight_1=mtp_w1,
                mtp_weight_2=mtp_w2,
            )
            ppl = (
                float(math.exp(min(20.0, val_loss_next)))
                if math.isfinite(val_loss_next)
                else float("nan")
            )
            writer.add_scalar("val/loss", val_loss, step)
            writer.add_scalar("val/loss_next", val_loss_next, step)
            writer.add_scalar("val/perplexity", ppl, step)

            for i, prompt in enumerate(prompts):
                sample = generate_sample(
                    model,
                    tokenizer,
                    prompt,
                    device,
                    amp_dtype,
                    max_new_tokens=96,
                    temperature=0.8,
                    top_k=40,
                    top_p=0.95,
                    system_prompt=cfg["data"]["chat_template"]["system"],
                    use_chat=use_chat_gen,
                )
                writer.add_text(
                    f"val/sample_{i}", f"PROMPT:\n{prompt}\n\n{sample}", step
                )

        if step > 0 and step % save_every == 0:
            save_checkpoint(
                ckpt_dir / f"step_{step}.pt",
                model,
                optimizer,
                scheduler,
                step,
                cfg,
            )
            save_checkpoint(
                ckpt_dir / "last.pt",
                model,
                optimizer,
                scheduler,
                step,
                cfg,
            )

    save_checkpoint(
        ckpt_dir / "final.pt",
        model,
        optimizer,
        scheduler,
        max_steps,
        cfg,
    )
    writer.close()


if __name__ == "__main__":
    main()
